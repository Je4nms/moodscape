# Copie este arquivo para .streamlit/secrets.toml e preencha com os dados
# do seu app em https://developer.spotify.com/dashboard
# O secrets.toml está no .gitignore, então ele nunca vai para o GitHub.

[spotify]
client_id = "cole-o-client-id-aqui"
client_secret = "cole-o-client-secret-aqui"
# Precisa ser IDÊNTICO a um dos Redirect URIs cadastrados no painel do Spotify
redirect_uri = "http://127.0.0.1:8501/"
